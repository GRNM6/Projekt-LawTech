# Kopiere diese Datei zu .env.local und trage deinen Schlüssel ein.
# Ohne Schlüssel läuft der Assistent im Demo-Modus mit Beispieldaten.
ANTHROPIC_API_KEY=

# Optional: anderes Claude-Modell verwenden
# ANTHROPIC_MODEL=claude-sonnet-5-5

# EUIPO-API (https://dev.euipo.europa.eu) – prüft die Begriffe gegen die harmonisierte Datenbank.
# Client-ID und Secret deiner App aus dem EUIPO-Portal. Ohne diese Werte wird die Prüfung übersprungen.
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
# sandbox (Standard) oder production
EUIPO_ENV=sandbox
# Nur für production nötig (URLs stehen nach Freischaltung im Portal):
# EUIPO_API_BASE=
# EUIPO_TOKEN_URL=
